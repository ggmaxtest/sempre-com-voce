# ====================================================================
# Sempre com Você — variáveis de ambiente (EXEMPLO)
#
# ZERO CONFIG: você NÃO precisa preencher nada para rodar.
# - Banco: SQLite embutido é criado automaticamente (server/data/).
# - JWT_SECRET: gerado e salvo automaticamente se você não definir.
#
# A ÚNICA coisa que habilita a IA a responder de verdade é a OPENAI_API_KEY.
# Copie este arquivo para .env e preencha o que quiser sobrescrever.
# ====================================================================

# --- (OPCIONAL) Segredo de sessão. Se vazio, é gerado automaticamente. ---
JWT_SECRET=

# --- (OBRIGATÓRIO para a IA responder) Chave da OpenAI ---
OPENAI_API_KEY=

# ====================================================================
# Tudo abaixo é OPCIONAL — já tem padrões sensatos.
# ====================================================================

NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:5173

# Banco: por padrão SQLite local. Para usar Postgres, descomente e ajuste:
# DATABASE_URL=postgresql://user:pass@host:5432/db?schema=public
# (ao trocar para Postgres, ajuste "provider" em server/prisma/schema.prisma para "postgresql")

JWT_EXPIRES_IN=7d
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_FAST=gpt-4o-mini
MODEL_SMART=gpt-4o
MODEL_VISION=gpt-4o
MODEL_IMAGE=gpt-image-1
MODEL_EMBEDDING=text-embedding-3-small

# Pesquisa na web (opcional): driver = tavily | serpapi | none
SEARCH_DRIVER=none
TAVILY_API_KEY=
SERPAPI_API_KEY=

# Admin inicial (criado no primeiro arranque)
ADMIN_EMAIL=admin@semprecomvoce.ai
ADMIN_PASSWORD=mude-esta-senha

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Integrações futuras (vazio = aparece como PENDENTE, nunca falso)
META_ACCESS_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
TIKTOK_ACCESS_TOKEN=
